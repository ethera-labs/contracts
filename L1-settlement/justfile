# Compose Contracts Deployment Commands

# Display available commands
default:
    @just --list

# ============================================================================
# Setup & Build
# ============================================================================

# Initialize submodules with specific tags
setup:
    @echo "Initializing git submodules..."
    @cd .. && git submodule update --init --recursive
    @echo "✓ Setup complete! Run 'just build' to compile contracts."

# Build all contracts
build:
    @echo "Building contracts..."
    forge build
    @echo "✓ Build complete!"

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    forge clean
    @echo "✓ Clean complete!"

# Validate environment setup
check-setup:
    @./check-setup.sh

# ============================================================================
# Network Management
# ============================================================================

# List available networks from networks.toml
list-networks:
    @echo "Available networks:"
    @grep "^\[networks\." networks.toml | sed 's/\[networks\.//g' | sed 's/\]//g' | sed 's/^/  - /g'

# Test network connection
test-network NETWORK:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    echo "Testing connection to $NETWORK_NAME..."
    echo "RPC URL: $NETWORK_RPC_URL"
    BLOCK=$(cast block-number --rpc-url "$NETWORK_RPC_URL" 2>&1)
    if [ $? -eq 0 ]; then
        echo "✓ Connected! Current block: $BLOCK"
    else
        echo "✗ Connection failed"
        exit 1
    fi

# ============================================================================
# Deployment Commands (Multi-Chain)
# ============================================================================

# Deploy to specific network
deploy-network NETWORK:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    ./scripts/deploy.sh {{NETWORK}}

# Deploy to multiple networks sequentially
deploy-multi *NETWORKS:
    #!/usr/bin/env bash
    set -euo pipefail
    for network in {{NETWORKS}}; do
        echo ""
        echo "========================================="
        echo "Deploying to $network..."
        echo "========================================="
        just deploy-network $network
        echo ""
    done
    echo "✓ All deployments complete!"
    echo ""
    just show-deployments

# Show all deployments from deployments.json
show-deployments:
    #!/usr/bin/env bash
    if [ ! -f deployments.json ]; then
        echo "No deployments found. Deploy contracts first."
        exit 1
    fi
    echo "=== Deployment Addresses ==="
    echo ""
    jq -r 'to_entries[] | "\\(.key) (Chain ID: \\(.value.chain_id)):\n  ComposeL2OutputOracle:\n    Proxy:          \\(.value.ComposeL2OutputOracle.proxy)\n    Implementation: \\(.value.ComposeL2OutputOracle.implementation)\n  ComposeDisputeGame:\n    Implementation: \\(.value.ComposeDisputeGame.implementation)\n  DisputeGameFactory:\n    Proxy:          \\(.value.DisputeGameFactory.proxy)\n    Implementation: \\(.value.DisputeGameFactory.implementation)\n    ProxyAdmin:     \\(.value.DisputeGameFactory.proxyAdmin)\n  Deployed:         \\(.value.deployed_at)\n"' deployments.json

# Get deployment addresses for specific network
get-deployment NETWORK:
    #!/usr/bin/env bash
    if [ ! -f deployments.json ]; then
        echo "No deployments found."
        exit 1
    fi
    jq ".\"{{NETWORK}}\"" deployments.json

# ============================================================================
# Verification
# ============================================================================

# Verify all contracts on Etherscan for a network
verify-all NETWORK:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    
    if [ ! -f deployments.json ]; then
        echo "No deployments found."
        exit 1
    fi
    
    ORACLE_IMPL=$(jq -r ".\"{{NETWORK}}\".ComposeL2OutputOracle.implementation" deployments.json)
    GAME_IMPL=$(jq -r ".\"{{NETWORK}}\".ComposeDisputeGame.implementation" deployments.json)
    FACTORY_IMPL=$(jq -r ".\"{{NETWORK}}\".DisputeGameFactory.implementation" deployments.json)
    PROXY_ADMIN=$(jq -r ".\"{{NETWORK}}\".DisputeGameFactory.proxyAdmin" deployments.json)
    
    echo "Verifying contracts on {{NETWORK}}..."
    just verify-oracle {{NETWORK}} $ORACLE_IMPL
    just verify-game {{NETWORK}} $GAME_IMPL
    just verify-factory {{NETWORK}} $FACTORY_IMPL
    just verify-proxy-admin {{NETWORK}} $PROXY_ADMIN

# Verify ComposeL2OutputOracle implementation
verify-oracle NETWORK ADDRESS:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    echo "Verifying ComposeL2OutputOracle at {{ADDRESS}}..."
    forge verify-contract {{ADDRESS}} \
        src/ComposeL2OutputOracle.sol:ComposeL2OutputOracle \
        --rpc-url "$NETWORK_RPC_URL" \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --chain-id "$NETWORK_CHAIN_ID" \
        --watch

# Verify ComposeDisputeGame implementation
verify-game NETWORK ADDRESS:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    ORACLE_PROXY=$(jq -r ".\"{{NETWORK}}\".ComposeL2OutputOracle.proxy" deployments.json)
    echo "Verifying ComposeDisputeGame at {{ADDRESS}}..."
    forge verify-contract {{ADDRESS}} \
        src/ComposeDisputeGame.sol:ComposeDisputeGame \
        --rpc-url "$NETWORK_RPC_URL" \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --chain-id "$NETWORK_CHAIN_ID" \
        --constructor-args $(cast abi-encode "constructor(address)" "$ORACLE_PROXY") \
        --watch

# Verify DisputeGameFactory implementation
verify-factory NETWORK ADDRESS:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    echo "Verifying DisputeGameFactory at {{ADDRESS}}..."
    forge verify-contract {{ADDRESS}} \
        --contract-path lib/optimism/packages/contracts-bedrock/src/dispute/DisputeGameFactory.sol:DisputeGameFactory \
        --rpc-url "$NETWORK_RPC_URL" \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --chain-id "$NETWORK_CHAIN_ID" \
        --watch

# Verify ProxyAdmin
verify-proxy-admin NETWORK ADDRESS:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    ADMIN_ADDRESS=$(jq -r ".\"{{NETWORK}}\".admin_address" deployments.json 2>/dev/null || echo "$NETWORK_ADMIN_ADDRESS")
    echo "Verifying ProxyAdmin at {{ADDRESS}}..."
    forge verify-contract {{ADDRESS}} \
        --contract-path lib/optimism/packages/contracts-bedrock/src/universal/ProxyAdmin.sol:ProxyAdmin \
        --rpc-url "$NETWORK_RPC_URL" \
        --etherscan-api-key "$ETHERSCAN_API_KEY" \
        --chain-id "$NETWORK_CHAIN_ID" \
        --constructor-args $(cast abi-encode "constructor(address)" "$ADMIN_ADDRESS") \
        --watch

# ============================================================================
# Individual Contract Deployment (Advanced)
# ============================================================================

# Deploy only ComposeL2OutputOracle
deploy-oracle NETWORK:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    echo "Deploying ComposeL2OutputOracle to {{NETWORK}}..."
    if [ -n "${ETHERSCAN_API_KEY:-}" ]; then
        forge script script/DeployComposeL2OutputOracle.s.sol:DeployComposeL2OutputOracle \
            --rpc-url "$NETWORK_RPC_URL" \
            --sig "run(address,address,address,bytes32,uint256)" \
            "$NETWORK_VERIFIER_ADDRESS" \
            "$NETWORK_OWNER_ADDRESS" \
            "$NETWORK_PROPOSER_ADDRESS" \
            "$NETWORK_AGGREGATION_VKEY" \
            "$NETWORK_STARTING_SUPERBLOCK_NUMBER" \
            --private-key "$DEPLOYER_PRIVATE_KEY" \
            --broadcast \
            --verify \
            --etherscan-api-key "$ETHERSCAN_API_KEY"
    else
        forge script script/DeployComposeL2OutputOracle.s.sol:DeployComposeL2OutputOracle \
            --rpc-url "$NETWORK_RPC_URL" \
            --sig "run(address,address,address,bytes32,uint256)" \
            "$NETWORK_VERIFIER_ADDRESS" \
            "$NETWORK_OWNER_ADDRESS" \
            "$NETWORK_PROPOSER_ADDRESS" \
            "$NETWORK_AGGREGATION_VKEY" \
            "$NETWORK_STARTING_SUPERBLOCK_NUMBER" \
            --private-key "$DEPLOYER_PRIVATE_KEY" \
            --broadcast
    fi

# Deploy only ComposeDisputeGame (requires oracle address)
deploy-game NETWORK ORACLE_ADDRESS:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/parse-network.sh {{NETWORK}}
    echo "Deploying ComposeDisputeGame to {{NETWORK}}..."
    if [ -n "${ETHERSCAN_API_KEY:-}" ]; then
        forge script script/DeployComposeDisputeGame.s.sol:DeployComposeDisputeGame \
            --rpc-url "$NETWORK_RPC_URL" \
            --sig "run(address)" {{ORACLE_ADDRESS}} \
            --private-key "$DEPLOYER_PRIVATE_KEY" \
            --broadcast \
            --verify \
            --etherscan-api-key "$ETHERSCAN_API_KEY"
    else
        forge script script/DeployComposeDisputeGame.s.sol:DeployComposeDisputeGame \
            --rpc-url "$NETWORK_RPC_URL" \
            --sig "run(address)" {{ORACLE_ADDRESS}} \
            --private-key "$DEPLOYER_PRIVATE_KEY" \
            --broadcast
    fi

