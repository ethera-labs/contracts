# ============================================================
# L1 — signing keys (config comes from config.json)
# ============================================================

# Owner of the Compose shared ProxyAdmin — used by l1-deploy-shared and migration scripts
# Default value below is Foundry test key #0 (Anvil). Replace with a real key for non-local networks.
PROXY_ADMIN_OWNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Guardian of SuperchainConfig — used by l1-deploy-shared
GUARDIAN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Owner of the rollup's own ProxyAdmin — used by l1-migrate-v3 and l1-migrate-v4
# Must correspond to rollups.<name>.l1.proxyAdminOwner in config.json
ROLLUP_OWNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ============================================================
# L2 — rollup selection + signing key (config comes from config.json)
# ============================================================

# Key under rollups in config.json that selects the active rollup
ROLLUP_NAME=chain-example

# Deployer key — used by all L2 scripts and V3 migration implementation deploys
DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC URL for forge script --rpc-url
# Set to L1 RPC for l1-deploy-shared and migration scripts
# Set to L2 RPC for l2-deploy-* scripts
RPC_URL=http://localhost:8545